   },
   "parent": "",
   "depth": -1,
   "events": [
    {
     "id": "ev_criar",
     "type": "create",
     "then": [
      {
       "type": "setAlarm",
       "target": "self",
       "alarm": 0,
       "seconds": 1
      }
     ]
    },
    {
     "id": "ev_alarme",
     "type": "alarm",
     "alarm": 0,
     "if": {
      "kind": "chance",
      "value": 80
     },
     "then": [
      {
       "type": "towards",
       "target": "self",
       "speed": 45
      },
      {
       "type": "setAlarm",
       "target": "self",
       "alarm": 0,
       "seconds": 1.2
      }
     ]
    },
    {
     "id": "ev_alarme_falhou",
     "type": "alarm",
     "alarm": 0,
     "if": {
      "kind": "chance",
      "value": 100
     },
     "then": [
      {
       "type": "setAlarm",
       "target": "self",
       "alarm": 0,
       "seconds": 1.2
      }
     ]
    },
    {
     "id": "ev_heroi",
     "type": "collision",
     "other": "ator_heroi",
     "then": [
      {
       "type": "damage",
       "target": "other",
       "value": 1
      },
      {
       "type": "reverseX",
       "target": "self"
      },
      {
       "type": "reverseY",
       "target": "self"
      }
     ]
    },
    {
     "id": "ev_faisca",
     "type": "collision",
     "other": "ator_faisca",
     "then": [
      {
       "type": "addLocal",
       "target": "self",
       "local": "acertos",
       "value": 1
      },
      {
       "type": "destroy",
       "target": "other"
      },
      {
       "type": "shake",
       "seconds": 0.15
      }
     ]
    },
    {
     "id": "ev_passo",
     "type": "step",
     "if": {
      "kind": "local",
      "local": "acertos",
      "op": ">=",
      "value": 2
     },
     "then": [
      {
       "type": "code",
       "lang": "crivo",
       "code": "explodir(self)\nglobal.pontos += 5\nsound_play(\"Explosão\")\ninstance_destroy()"
      }
     ]
    }
   ]
  }
