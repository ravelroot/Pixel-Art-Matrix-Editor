 "rules": [
  {
   "id": "regra_1",
   "scene": "cena_1",
   "when": {
    "type": "start"
   },
   "then": [
    {
     "type": "message",
     "text": "Pegue as moedas e chegue à bandeira! X solta faíscas.",
     "seconds": 3
    }
   ],
   "note": ""
  },
  {
   "id": "regra_2",
   "scene": "cena_2",
   "when": {
    "type": "start"
   },
   "then": [
    {
     "type": "message",
     "text": "Fase 2: cuidado com os morcegos!",
     "seconds": 2.5
    }
   ],
   "note": ""
  },
  {
   "id": "regra_3",
   "scene": "",
   "when": {
    "type": "var",
    "name": "pontos",
    "op": ">=",
    "value": 20
   },
   "then": [
    {
     "type": "add",
     "name": "vidas",
     "value": 1
    },
    {
     "type": "sound",
     "sound": "som_powerup"
    },
    {
     "type": "message",
     "text": "20 moedas: +1 vida!",
     "seconds": 2
    }
   ],
   "note": ""
  },
  {
   "id": "regra_4",
   "scene": "",
   "when": {
    "type": "destroyed",
    "actor": "ator_gosma"
   },
   "then": [
    {
     "type": "add",
     "name": "pontos",
     "value": 2
    },
    {
     "type": "code",
     "lang": "crivo",
     "code": "explodir(self)"
    }
   ],
   "note": ""
  }
 ],
 "scripts": [
  {
   "id": "script_cpp",
   "name": "pontuacao_cpp",
   "lang": "cpp",
   "code": "#include <crivo>\n\nint bonus_por_vida(int vidas) {\n  return vidas * 10;\n}\n\nvoid relatorio() {\n  std::cout << \"C++: \" << global::pontos << \" pontos, bônus \" << bonus_por_vida(global::vidas) << std::endl;\n}\n"
  },
  {
   "id": "script_lua",
   "name": "magia_lua",
   "lang": "lua",
   "code": "function chuva_de_moedas(n)\n  for i = 1, n do\n    instance_create(\"Moeda\", x + i * 10, y - 24)\n  end\n  return bonus_por_vida(n)\nend\n"
  },
  {
   "id": "script_efeitos",
   "name": "efeitos",
   "lang": "crivo",
   "code": "global.recorde = 0\n\nfunction explodir(alvo) {\n  particles(alvo.x + 4, alvo.y + 4, 18, \"#f6e4a6\", 70, 0.6)\n  shake(0.2)\n}\n\nfunction placar() {\n  return \"pontos: \" + string(global.pontos) + \" | vidas: \" + string(global.vidas)\n}\n"
  }
 ],
 "gridSize": 8,
 "start": "cena_1"
}
